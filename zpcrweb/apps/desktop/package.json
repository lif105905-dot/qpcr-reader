{
  "name": "@zpcrweb/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "LabKit desktop shell: Western analysis + qPCR reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.labkit",
    "productName": "LabKit",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      },
      {
        "from": "../western/src",
        "to": "western/src"
      },
      {
        "from": "../western/vendor",
        "to": "western/vendor"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "CFBundleName": "LabKit",
        "CFBundleDisplayName": "LabKit",
        "NSHumanReadableCopyright": "GPL-3.0-or-later · 基于 zpcrweb"
      }
    },
    "electronVersion": "33.4.11",
    "electronDist": "/Users/lijiehui/Documents/qpcr-tool/electron-dist",
    "asar": true
  },
  "author": "local build",
  "dependencies": {
    "app-builder-bin": "^4.2.0"
  }
}
